NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
ANTHROPIC_API_KEY=your-anthropic-api-key
DAILY_GENERATION_LIMIT=5
# Real cost cap: default 30/month keeps AI spend to roughly $1/user/month at worst-case token usage.
MONTHLY_GENERATION_LIMIT=30
# Optional: model used to build study sets. Defaults to the cheapest (claude-haiku-4-5-20251001).
GENERATION_MODEL=

# Payments — optional. The Campus Archive subscription stays disabled until these are set.
# Set EITHER a Stripe Price id (recommended) OR a monthly price in cents (e.g. 499).
STRIPE_ARCHIVE_PRICE_ID=
ARCHIVE_MONTHLY_PRICE_CENTS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: id of a Stripe Coupon (percent_off, duration "once") to grant as a
# referral reward — a discount on next month for both sides, never cash.
# Referrals silently do nothing until this is set. Create it in the Stripe
# dashboard under Product catalog > Coupons.
STRIPE_REFERRAL_COUPON_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=
