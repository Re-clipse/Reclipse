NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only. Bypasses Row Level Security entirely — never expose to the
# client, never prefix with NEXT_PUBLIC_. Used by lib/supabaseAdmin.js for
# cron/webhook routes that act on behalf of the system, not one user.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: model used to build study sets. Defaults to the cheapest (claude-haiku-4-5-20251001).
GENERATION_MODEL=
# Syllabus-upload rate limit (calendar month), enforced immediately.
MONTHLY_SYLLABUS_LIMIT=10

# Reclipse Plus usage limits — see the cost arithmetic in app/api/generate/route.js.
# Free: 1 generation/day (no monthly-count throttle, just this daily one).
FREE_DAILY_GENERATION_LIMIT=1
# Free: up to this many flashcards/month, across however many generations that takes.
FREE_MONTHLY_CARD_LIMIT=900
# Premium (Reclipse Plus): no daily limit, up to this many flashcards/month.
PREMIUM_MONTHLY_CARD_LIMIT=2700
# Everyone has premium for free until this date (ISO 8601, e.g. 2026-10-06T00:00:00Z) —
# the launch-week trial. Leave unset until you actually know the launch date: unset
# means "trial still active for everyone" (safe default), not "trial over."
# This must be NEXT_PUBLIC_ since both the client and server need to read it.
NEXT_PUBLIC_PREMIUM_TRIAL_ENDS_AT=

# Payments — optional. Reclipse Plus checkout stays disabled until STRIPE_SECRET_KEY
# and STRIPE_PREMIUM_WEBHOOK_SECRET are both set. Not Campus Archive (shelved, below).
# For each interval, set EITHER a Stripe Price id (recommended) OR a price in cents.
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
PREMIUM_MONTHLY_PRICE_CENTS=
STRIPE_PREMIUM_ANNUAL_PRICE_ID=
PREMIUM_ANNUAL_PRICE_CENTS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Reclipse Plus's webhook has its own signing secret — Stripe signs each
# configured endpoint separately, and this is a separate endpoint from Archive's.
STRIPE_PREMIUM_WEBHOOK_SECRET=
# Optional: id of a Stripe Coupon (percent_off, duration "once") to grant as a
# referral reward — a discount on next month for both sides, never cash.
# Referrals silently do nothing until this is set. Create it in the Stripe
# dashboard under Product catalog > Coupons.
STRIPE_REFERRAL_COUPON_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Campus Archive — SHELVED. Kept only so existing archived-deck data and the
# "coming soon" page still work; do not build new features against this.
# Reclipse Plus (above) is the actual premium product going forward.
# Set EITHER a Stripe Price id (recommended) OR a monthly price in cents (e.g. 499).
STRIPE_ARCHIVE_PRICE_ID=
ARCHIVE_MONTHLY_PRICE_CENTS=
# Required to run app/api/send-reminders/route.js and app/api/purge-trash/route.js —
# both fail closed (503) if this is unset, rather than skipping their auth check.
CRON_SECRET=
# Resend API key used to actually send reminder emails. If unset, sends
# fail (Resend rejects the request) but the cron run itself still completes.
RESEND_API_KEY=your-resend-api-key
# Signs the no-login unsubscribe link sent with every reminder email
# (course-event, study-session, and weekly-digest). Any long random string —
# generate one with `openssl rand -hex 32`. Unsubscribe links silently fail
# to verify until this is set.
EMAIL_UNSUBSCRIBE_SECRET=
